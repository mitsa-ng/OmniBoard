# ── Backend ──────────────────────────────────────────
DATABASE_URL=postgres://omniboard:omniboard_dev_password@localhost:5432/omniboard
SYNC_API_KEY=replace-with-a-strong-random-secret
ALLOWED_WEB_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
PUBLIC_CACHE_MAX_AGE_SECONDS=60
PORT=3000
RUST_LOG=omniboard_backend=info,tower_http=info

# ── Frontend (Vite) ─────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
